SAFELINE_BASE_URL=https://safeline.example.com:9443
SAFELINE_API_TOKEN=replace-with-safeline-api-token
LLM_API_KEY=replace-with-llm-api-key
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-chat
LLM_PROXY=
LLM_VERIFY_SSL=true
BLACKLIST_GROUP=ai-agent-blacklist
WEB_HOST=127.0.0.1
WEB_PORT=8000
AUTO_MODE_ENABLED=false
AUTO_SCAN_INTERVAL_SECONDS=60
AUTO_LOOKBACK_HOURS=24
AUTO_MAX_RECORDS_PER_SCAN=100
AUTO_MAX_BLOCKS_PER_SCAN=10
